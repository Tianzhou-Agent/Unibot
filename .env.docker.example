# Copy this file to .env before running Docker Compose.
# Replace every value marked CHANGE_ME before exposing the service publicly.

UNIBOT_HTTP_PORT=8080
UNIBOT_BACKEND_PORT=8000
# Frontend context root, including the trailing slash. Use /superbot/ for a domain subpath.
UNIBOT_BASE_PATH=/

UNIBOT_MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
UNIBOT_MYSQL_DATABASE=unibot
UNIBOT_MYSQL_USER=unibot
UNIBOT_MYSQL_PASSWORD=CHANGE_ME_mysql_password
# URL-encode reserved characters in the password used in this DSN.
TZ_STORAGE_MYSQL_DSN=mysql+aiomysql://unibot:CHANGE_ME_mysql_password@mysql:3306/unibot
TZ_STORAGE_REDIS_DSN=redis://redis:6379/0

# Generate a unique random value of at least 32 characters. All backend nodes must share it.
UNIBOT_AUTH_SECRET=CHANGE_ME_to_a_random_secret_of_at_least_32_characters
UNIBOT_AUTH_SESSION_HOURS=168
UNIBOT_AUTH_COOKIE_SECURE=false
UNIBOT_AUTH_REGISTRATION_ENABLED=true
UNIBOT_FRONTEND_BASE_URL=http://127.0.0.1:8080

UNIBOT_LLM_BASE_URL=https://api.deepseek.com
UNIBOT_LLM_API_KEY=
UNIBOT_LLM_MODEL=deepseek-chat

# Optional GitHub OAuth App. Leave both credentials empty to hide GitHub login.
UNIBOT_GITHUB_CLIENT_ID=
UNIBOT_GITHUB_CLIENT_SECRET=
UNIBOT_GITHUB_CALLBACK_URL=http://127.0.0.1:8080/api/auth/github/callback
# Optional Huawei Uniportal OAuth.
# Also accepts Nexent UNIPORTAL_URL, HUAWEI_OAUTH_CLIENT_ID, HUAWEI_OAUTH_CLIENT_SECRET.
# Non-empty UNIBOT_* values take precedence over these aliases.
UNIBOT_HUAWEI_BASE_URL=
UNIBOT_HUAWEI_CLIENT_ID=
UNIBOT_HUAWEI_CLIENT_SECRET=
UNIBOT_HUAWEI_CALLBACK_URL=http://127.0.0.1:8080/api/auth/huawei/callback
UNIBOT_HUAWEI_SSL_VERIFY=true
# Path inside the backend container; mount the internal CA bundle separately if needed.
UNIBOT_HUAWEI_CA_BUNDLE=
# Optional Google and Microsoft OIDC sign-in.
UNIBOT_GOOGLE_CLIENT_ID=
UNIBOT_GOOGLE_CLIENT_SECRET=
UNIBOT_GOOGLE_CALLBACK_URL=http://127.0.0.1:8080/api/auth/google/callback
UNIBOT_MICROSOFT_CLIENT_ID=
UNIBOT_MICROSOFT_CLIENT_SECRET=
UNIBOT_MICROSOFT_CALLBACK_URL=http://127.0.0.1:8080/api/auth/microsoft/callback
UNIBOT_MICROSOFT_TENANT=common
# Apple requires an HTTPS callback, AUTH_COOKIE_SECURE=true, and an ES256 client-secret JWT.
UNIBOT_APPLE_CLIENT_ID=
UNIBOT_APPLE_CLIENT_SECRET=
UNIBOT_APPLE_CALLBACK_URL=
# Immutable user IDs from /auth/me, provisioned after creating the intended account.
# Email addresses and GitHub login names do not grant administrator access.
UNIBOT_ADMIN_IDENTITIES=
# Exact approved origins, including scheme/port; empty disables remote Tools/AINA.
# Example: https://connector.example.com,http://trusted-service:8080
UNIBOT_CAPABILITY_ALLOWED_ORIGINS=
# Local execution stays disabled until explicitly enabled for trusted users only.
UNIBOT_SANDBOX_DRIVER=local
UNIBOT_SANDBOX_ALLOW_UNSAFE_LOCAL=false

YOLO_IMAGE_SIZE=640
YOLO_MAX_CONCURRENCY=1
YOLO_MAX_IMAGE_PIXELS=40000000
UNIBOT_VISION_MAX_IMAGE_BYTES=10485760
