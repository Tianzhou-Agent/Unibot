llm_base_url="https://api.deepseek.com"
llm_api_key="sk-123"
llm_model="deepseek-v4-flash"

# Keep this aligned with the selected model. Compression runs at 75% and retains the latest 4 complete user turns.
UNIBOT_CONTEXT_COMPRESSION_ENABLED="true"
UNIBOT_CONTEXT_WINDOW_TOKENS="128000"
UNIBOT_CONTEXT_COMPRESSION_THRESHOLD_RATIO="0.75"
UNIBOT_CONTEXT_COMPRESSION_KEEP_RECENT_TURNS="4"
UNIBOT_CONTEXT_COMPRESSION_MIN_MESSAGES="8"

TZ_STORAGE_MYSQL_DSN="mysql+aiomysql://unibot:unibot@127.0.0.1:13306/unibot"
TZ_STORAGE_REDIS_DSN="redis://127.0.0.1:16379/0"
# Optional dedicated Redis for OBS Streams; defaults to TZ_STORAGE_REDIS_DSN.
TZ_STORAGE_OBS_REDIS_DSN=""
TZ_STORAGE_NAS_ROOT_PATH="../data/nas"

# OBS Streams requires Redis 7.2+ with AOF enabled. Production can wait for
# durable replica acknowledgements by setting this to the replica count.
UNIBOT_OBS_REDIS_WAIT_REPLICAS="0"

UNIBOT_VISION_BASE_URL="http://127.0.0.1:18081"
UNIBOT_VISION_TIMEOUT_SECONDS="60"
UNIBOT_VISION_MAX_IMAGE_BYTES="10485760"

# All backend nodes must share this secret. Generate a unique high-entropy value in production.
UNIBOT_AUTH_SECRET="replace-with-a-long-random-production-secret"
UNIBOT_AUTH_SESSION_HOURS="168"
UNIBOT_AUTH_COOKIE_SECURE="false"
UNIBOT_AUTH_REGISTRATION_ENABLED="true"
UNIBOT_FRONTEND_BASE_URL="http://127.0.0.1:5173"

# Optional GitHub OAuth App. Leave both credentials empty to hide GitHub login.
UNIBOT_GITHUB_CLIENT_ID=""
UNIBOT_GITHUB_CLIENT_SECRET=""
UNIBOT_GITHUB_CALLBACK_URL="http://127.0.0.1:5173/api/auth/github/callback"
