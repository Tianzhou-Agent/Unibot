{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unibot.example/schemas/aina/2.0/aina.schema.json",
  "title": "AINA package manifest (aina.json), protocol 2.0",
  "type": "object",
  "required": ["protocol_version", "aina", "tools"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "protocol_version": { "const": "2.0" },
    "aina": { "$ref": "#/$defs/identity" },
    "tools": { "$ref": "#/$defs/tools" },
    "skills": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/skill" }
    },
    "canvas": { "$ref": "#/$defs/canvas" },
    "widgets": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/widget" }
    },
    "config": {
      "type": "object",
      "required": ["schema"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "object" }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/permission" }
    }
  },
  "$defs": {
    "package_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*//)[^\\\\\\u0000]+$"
    },
    "tool_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "local_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "effect": {
      "enum": ["read", "write", "destructive"]
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#]+",
      "maxLength": 2048
    },
    "mcp_url": {
      "description": "HTTPS Streamable HTTP endpoint; plain HTTP is accepted only for loopback development servers.",
      "type": "string",
      "format": "uri",
      "pattern": "^(https://[^/?#]+|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]{1,5})?([/?#]|$))",
      "maxLength": 2048
    },
    "identity": {
      "type": "object",
      "required": ["id", "version", "name", "description", "publisher"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "publisher": {
          "type": "object",
          "required": ["id", "name"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 160 },
            "name": { "type": "string", "minLength": 1, "maxLength": 160 },
            "url": { "$ref": "#/$defs/https_url" }
          }
        },
        "icon": { "$ref": "#/$defs/package_path" },
        "locales": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 160 },
              "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "required": ["mcp", "expose"],
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "type": "object",
          "required": ["url", "auth"],
          "additionalProperties": false,
          "properties": {
            "url": { "$ref": "#/$defs/mcp_url" },
            "auth": { "$ref": "#/$defs/mcp_auth" }
          }
        },
        "expose": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "$ref": "#/$defs/tool_name" },
          "additionalProperties": { "$ref": "#/$defs/exposed_tool" }
        }
      }
    },
    "mcp_auth": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["none", "bearer", "api_key", "oauth2"] },
        "secret": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
        "header": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["bearer", "api_key"] } } },
          "then": { "required": ["secret"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["none", "oauth2"] } } },
          "then": { "not": { "anyOf": [{ "required": ["secret"] }, { "required": ["header"] }] } }
        }
      ]
    },
    "exposed_tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effect": { "$ref": "#/$defs/effect" },
        "visibility": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["model", "app"] }
        },
        "confirm_widget": { "$ref": "#/$defs/local_id" },
        "result_widget": { "$ref": "#/$defs/local_id" },
        "long_running": { "type": "boolean" },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 }
      }
    },
    "skill": {
      "type": "object",
      "required": ["id", "name", "description", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/local_id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "path": { "$ref": "#/$defs/package_path" },
        "tools": {
          "type": "array",
          "maxItems": 48,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tool_name" }
        }
      }
    },
    "canvas": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "entry": { "$ref": "#/$defs/package_path" },
        "url": { "$ref": "#/$defs/https_url" },
        "tools": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/canvas_tool" }
        }
      },
      "oneOf": [
        { "required": ["entry"], "not": { "required": ["url"] } },
        { "required": ["url"], "not": { "required": ["entry"] } }
      ]
    },
    "canvas_tool": {
      "type": "object",
      "required": ["name", "description", "inputSchema"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/tool_name" },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "inputSchema": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "object" } }
        },
        "outputSchema": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "object" } }
        },
        "effect": { "$ref": "#/$defs/effect" },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 }
      }
    },
    "widget": {
      "type": "object",
      "required": ["id", "purpose", "entry"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/local_id" },
        "purpose": { "enum": ["confirmation", "result", "display"] },
        "entry": { "$ref": "#/$defs/package_path" },
        "height": { "type": "integer", "minimum": 1, "maximum": 480 }
      }
    },
    "permission": {
      "type": "object",
      "required": ["scope"],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "storage",
            "notify",
            "documents.read",
            "documents.write",
            "memory.read",
            "memory.write",
            "llm",
            "sandbox.exec"
          ]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
        "optional": { "type": "boolean" }
      }
    }
  }
}
