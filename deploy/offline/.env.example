# Run bash init-config.sh to generate fresh secrets in .env.
UNIBOT_HTTP_BIND=0.0.0.0
UNIBOT_HTTP_PORT=8080
UNIBOT_BACKEND_PORT=8000
UNIBOT_MYSQL_ROOT_PASSWORD=CHANGE_ME
UNIBOT_MYSQL_DATABASE=unibot
UNIBOT_MYSQL_USER=unibot
# Use a hex password, or URL-encode reserved characters for the database DSN.
UNIBOT_MYSQL_PASSWORD=CHANGE_ME
UNIBOT_AUTH_SECRET=CHANGE_ME
UNIBOT_AUTH_COOKIE_SECURE=false
UNIBOT_AUTH_REGISTRATION_ENABLED=true
UNIBOT_FRONTEND_BASE_URL=http://SERVER_IP:8080/superbot
# Internal OpenAI-compatible model endpoint reachable from the backend container.
UNIBOT_LLM_BASE_URL=
UNIBOT_LLM_API_KEY=
UNIBOT_LLM_MODEL=
UNIBOT_GITHUB_CLIENT_ID=
UNIBOT_GITHUB_CLIENT_SECRET=
UNIBOT_GITHUB_CALLBACK_URL=http://SERVER_IP:8080/superbot/api/auth/github/callback
UNIBOT_ADMIN_IDENTITIES=
UNIBOT_PUBLIC_ORIGIN=http://SERVER_IP:8080
UNIBOT_CAPABILITY_ALLOWED_ORIGINS=http://SERVER_IP:8080
UNIBOT_AINA_CANVAS_ALLOWED_ORIGINS=http://SERVER_IP:8080
UNIBOT_SANDBOX_DRIVER=local
UNIBOT_SANDBOX_ALLOW_UNSAFE_LOCAL=false
UNIBOT_HUAWEI_BASE_URL=
UNIBOT_HUAWEI_CLIENT_ID=
UNIBOT_HUAWEI_CLIENT_SECRET=
UNIBOT_HUAWEI_CALLBACK_URL=http://SERVER_IP:8080/superbot/api/auth/huawei/callback
UNIBOT_HUAWEI_SSL_VERIFY=true
UNIBOT_HUAWEI_CA_BUNDLE=
UNIBOT_GOOGLE_CLIENT_ID=
UNIBOT_GOOGLE_CLIENT_SECRET=
UNIBOT_GOOGLE_CALLBACK_URL=http://SERVER_IP:8080/superbot/api/auth/google/callback
UNIBOT_MICROSOFT_CLIENT_ID=
UNIBOT_MICROSOFT_CLIENT_SECRET=
UNIBOT_MICROSOFT_CALLBACK_URL=http://SERVER_IP:8080/superbot/api/auth/microsoft/callback
UNIBOT_MICROSOFT_TENANT=common
UNIBOT_APPLE_CLIENT_ID=
UNIBOT_APPLE_CLIENT_SECRET=
UNIBOT_APPLE_CALLBACK_URL=http://SERVER_IP:8080/superbot/api/auth/apple/callback
