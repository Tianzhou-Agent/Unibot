{
  "openapi": "3.1.0",
  "info": {
    "title": "Superbot AINA Host API",
    "version": "2.0",
    "description": "What an AINA 2.0 MCP server may ask of the Superbot host on behalf of one tool call. Every request carries the call's context token (`_meta[\"unibot/context\"].token`) as a bearer token; each route also needs one permission the user granted (`storage`, `documents.read`, `documents.write`, `memory.read`, `memory.write`, `llm`). Task callbacks and `token/refresh` need only a token of the invocation that started the task. The server URL is the call's `_meta[\"unibot/context\"].host.api_base`."
  },
  "servers": [
    {
      "url": "{api_base}",
      "variables": {
        "api_base": {
          "default": "https://unibot.example.com/api/aina-host/v1"
        }
      }
    }
  ],
